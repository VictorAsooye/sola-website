# Copy to `.env.local` for local dev and set the same keys in Vercel
# (Project → Settings → Environment Variables) for production.

# Supabase — the project holding the `demo_requests` table
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=eyJ...service_role_key...

# Resend — used to email the sales/demo team when a request comes in
RESEND_API_KEY=re_...

# Optional — override where notification emails land (defaults to victorasooye@gmail.com)
DEMO_NOTIFY_EMAIL=hello@solasupport.com

# Optional — verified Resend sender identity
RESEND_FROM_EMAIL=Sola AI Consulting <hello@solasupport.com>
